# Base Environment Variables
NODE_ENV=production
PORT=4000
STOREFRONT_URL=https://curiowraps-storefront.vercel.app
ADMIN_URL=https://curiowraps-admin.vercel.app
CORS_ORIGINS=https://curiowraps-storefront.vercel.app,https://curiowraps-admin.vercel.app

# PostgreSQL Database (Supabase)
DATABASE_URL=postgresql://postgres:[PASSWORD]@[HOST]:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres

# Redis Cache & Queues (Upstash)
REDIS_URL=redis://default:[PASSWORD]@[HOST]:32890

# JWT Auth Secrets (Generate strong random 32-char strings)
JWT_ACCESS_SECRET=your-secure-access-secret-min-32-chars
JWT_REFRESH_SECRET=your-secure-refresh-secret-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Auth Cookies
AUTH_COOKIE_NAME=refresh_token
AUTH_COOKIE_PATH=/api/v1/auth
AUTH_COOKIE_SAMESITE=lax
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_DOMAIN=.example.com

# Media Optimization (Cloudinary)
CLOUDINARY_URL=cloudinary://[API_KEY]:[API_SECRET]@[CLOUD_NAME]

# Frontend Specific (Storefront / Admin)
NEXT_PUBLIC_API_URL=https://dashboardapi-production-7ced.up.railway.app/api/v1

# Email Dispatch (Brevo SMTP)
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_USER=your-brevo-smtp-user
BREVO_SMTP_PASS=your-brevo-smtp-password
EMAIL_FROM=onboarding@curiowrap.com
