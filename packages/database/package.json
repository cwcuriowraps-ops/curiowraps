{
  "name": "@dashboard/database",
  "version": "0.1.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "npm run prisma:generate && tsc",
    "dev": "DATABASE_URL=${DATABASE_URL:-postgresql://postgres:postgres@localhost:5432/ecommerce?schema=public} prisma generate --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist",
    "prisma:generate": "DATABASE_URL=${DATABASE_URL:-postgresql://postgres:postgres@localhost:5432/ecommerce?schema=public} prisma generate",
    "prisma:validate": "DATABASE_URL=${DATABASE_URL:-postgresql://postgres:postgres@localhost:5432/ecommerce?schema=public} prisma validate",
    "prisma:studio": "DATABASE_URL=${DATABASE_URL:-postgresql://postgres:postgres@localhost:5432/ecommerce?schema=public} prisma studio",
    "prisma:migrate:dev": "DATABASE_URL=${DATABASE_URL:-postgresql://postgres:postgres@localhost:5432/ecommerce?schema=public} prisma migrate dev",
    "seed": "DATABASE_URL=${DATABASE_URL:-postgresql://postgres:postgres@localhost:5432/ecommerce?schema=public} tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.12.0"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.5.0",
    "@types/node": "^24.0.10",
    "prisma": "^6.12.0",
    "rimraf": "^6.0.1",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
